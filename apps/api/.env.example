# Copy to .env for local development. All settings are prefixed SMOODIE_.
SMOODIE_ENV=local
SMOODIE_DATABASE_URL=postgresql+asyncpg://smoodie:smoodie@localhost:5432/smoodie

# Local dev serves plain http, and browsers refuse to send Secure cookies over
# it — leave this false locally, and never set it false anywhere deployed.
SMOODIE_COOKIE_SECURE=false
SMOODIE_FIREBASE_PROJECT_ID=smoodie-dev
